# Keep mutable data and hooks in Taskwarrior's established location.  Using a
# home-relative path makes the configuration portable between machines.
data.location=~/.task
hooks.location=~/.task/hooks

# Match the local calendar convention while retaining Taskwarrior's safe
# defaults for confirmations and bulk changes.
weekstart=Monday

# Generated by `config theme` from the active Modus palette.
include ~/.config/modus-theme/taskwarrior.theme
