# .zshrc -- a small, Vi-oriented interactive shell.
#
# This intentionally uses Zsh's built-ins instead of a plugin framework. Keep
# additions here motivated by a repeated interactive need.

[[ -o interactive ]] || return

# Keep user-installed commands ahead of system commands without duplicating
# entries when this file is sourced more than once.
path=("$HOME/.local/bin" "$HOME/bin" $path)
typeset -U path PATH

export EDITOR=nvim
export VISUAL=nvim
export SUDO_EDITOR=nvim
export TERMINAL=alacritty

# The local chess data setting is shared with Bash.
[[ -r "$HOME/.bashrc.d/50-chessable-export" ]] && source "$HOME/.bashrc.d/50-chessable-export"

[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

alias ls='ls --color=auto --group-directories-first'
alias grep='grep --color=auto'
alias vi=vim
alias e=nvim
alias p=project

_config_completion() {
    if (( CURRENT == 2 )); then
        _describe -t commands command \
            'link:link this repository into $HOME' \
            'unlink:remove links owned by this repository' \
            'status:show the state of managed links' \
            'update:update stable Rust and repository tools' \
            'packages:manage system packages' \
            'help:show help'
    elif [[ $words[2] == packages && $CURRENT == 3 ]]; then
        _describe -t commands command \
            'install:install packages declared for this distribution' \
            'upgrade:upgrade all system packages'
    elif [[ $CURRENT -eq 3 || $CURRENT -eq 4 ]]; then
        _arguments '--dry-run[print commands without running them]'
    fi
}

# Share useful history between interactive shells without retaining duplicate
# or accidental commands that start with a space.
history_directory="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
mkdir -p -- "$history_directory"
HISTFILE="$history_directory/history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt inc_append_history
setopt share_history

# Native completion is deliberately enabled before optional tool integrations.
fpath=("${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions" $fpath)
autoload -Uz compinit
completion_directory="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p -- "$completion_directory"
compinit -d "$completion_directory/zcompdump"
compdef _config_completion config
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' verbose yes

# Work from directories by name, without adding a prompt framework.
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_minus

# Cache the abbreviated path when changing directories.
_update_prompt_path() {
    local dir=$PWD short='' part
    if [[ $dir != / && $dir != "$HOME" ]]; then
        short=/${dir:t}
        dir=${dir:h}
        while [[ $dir != / && $dir != "$HOME" ]]; do
            part=${dir:t}
            if [[ $part == .* ]]; then
                part=${part[1,2]}
            else
                part=${part[1]}
            fi
            short=/${part:l}$short
            dir=${dir:h}
        done
    fi
    [[ $dir == "$HOME" ]] && short="~$short"
    psvar[1]=${short:-/}
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _update_prompt_path
_update_prompt_path
PROMPT='%F{blue}%1v%f %(?.%F{#db7b5f}❯%f.%F{yellow}❯%f) '

# ZVM owns the Vi keymaps and modal-editing experience. Its cursor-shape and
# clipboard integration use the terminal and Wayland tools already in use.
ZVM_VI_EDITOR=$EDITOR
ZVM_SYSTEM_CLIPBOARD_ENABLED=true
zvm_plugin="$HOME/.local/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"
# Search on request, after ZVM has initialized its keymaps.
zvm_after_init() {
    local plugin="$HOME/.local/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
    [[ -r $plugin ]] || return 0
    source "$plugin"
    local mode
    for mode in viins vicmd; do
        bindkey -M "$mode" '^[[A' history-substring-search-up
        bindkey -M "$mode" '^[[B' history-substring-search-down
        bindkey -M "$mode" '^[OA' history-substring-search-up
        bindkey -M "$mode" '^[OB' history-substring-search-down
    done
}
[[ -r $zvm_plugin ]] && source "$zvm_plugin"

# Open lf and adopt its final directory. Ctrl-O is available in insert mode.
if (( $+commands[lf] )); then
    lfcd() {
        local directory temporary_file
        temporary_file=$(mktemp) || return
        command lf -last-dir-path="$temporary_file" "$@"
        directory=$(<"$temporary_file")
        rm -f -- "$temporary_file"
        [[ -d $directory ]] && cd -- "$directory"
    }

    lfcd-widget() {
        zle -I
        lfcd
        zle reset-prompt
    }

    zle -N lfcd-widget
    bindkey -M viins '^O' lfcd-widget
fi

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi

if (( $+commands[fzf] )); then
    export FZF_DEFAULT_OPTS='--layout=reverse --height=~12 --prompt="› " --pointer="▸" --marker="•" --color=bg:#0d0e1c,bg+:#1d2235,fg:#c6daff,fg+:#ffffff,hl:#2fafff,hl+:#2fafff,header:#989898,info:#989898,prompt:#2fafff,pointer:#2fafff,marker:#2fafff,spinner:#2fafff,separator:#61647a,gutter:#0d0e1c,query:#ffffff,scrollbar:#61647a,selected-bg:#2fafff,selected-fg:#0d0e1c'
    fzf_shell_directory=/usr/share/fzf/shell
    [[ -r "$fzf_shell_directory/key-bindings.zsh" ]] && source "$fzf_shell_directory/key-bindings.zsh"
fi
