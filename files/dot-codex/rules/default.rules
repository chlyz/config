# Read-only JSON inspection is safe in this trusted configuration repository.
prefix_rule(
    pattern = ["jq"],
    decision = "allow",
    justification = "Allow read-only JSON inspection without an approval prompt.",
)

# Read-only source inspection.
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["pgrep"], decision = "allow")
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["swaymsg", "-t", "get_tree"], decision = "allow")
prefix_rule(pattern = ["swaymsg", "-t", "get_binding_modes"], decision = "allow")
prefix_rule(pattern = ["journalctl", "--user", "-u"], decision = "allow")
prefix_rule(pattern = ["systemctl", "--user", "status"], decision = "allow")
prefix_rule(pattern = ["systemctl", "--user", "is-active"], decision = "allow")
prefix_rule(pattern = ["systemctl", "--user", "is-enabled"], decision = "allow")
prefix_rule(pattern = ["systemctl", "--user", "show-environment"], decision = "allow")

# Rust verification commands may create build artefacts, but do not alter source.
prefix_rule(pattern = ["cargo", "test"], decision = "allow")
prefix_rule(pattern = ["cargo", "clippy"], decision = "allow")
prefix_rule(pattern = ["cargo", "fmt", "--check"], decision = "allow")
prefix_rule(pattern = ["cargo", "check"], decision = "allow")

# Re-link the trusted dotfiles package without an approval prompt.
prefix_rule(
    pattern = ["config", "link"],
    decision = "allow",
    justification = "Install this repository's managed dotfiles and command rules.",
)
prefix_rule(pattern=["sed", "-n", "430,540p", "src/main.rs"], decision="allow")
prefix_rule(pattern=["/home/chrly/.local/bin/i3ipc-dynamic-tiling", "--workspace", "4", "--monocle"], decision="allow")
prefix_rule(pattern=["jq", "-r", ".. | objects | select(.type? == \"workspace\" and .name? == \"4\") | {layout,representation}"], decision="allow")
prefix_rule(pattern=["curl", "--fail", "--silent", "--show-error"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,290p", "tools/ferrichess/src/main.rs"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["curl", "--fail", "--silent", "--show-error", "--location"], decision="allow")
prefix_rule(pattern=["cat", "/tmp/kamryn-chrome.log"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "task_browser=$(mktemp -d) && google-chrome --headless=new --no-sandbox --disable-gpu --remote-debugging-port=9224 --user-data-dir=\"$task_browser\" --window-size=1600,1000 'https://www.youtube.com/watch?v=GMuo4VQXxeE'"], decision="allow")
prefix_rule(pattern=["curl", "-sS", "http://127.0.0.1:9224/json"], decision="allow")
prefix_rule(pattern=["node", "-e", "const fs=require(\"fs\"); const ws=new WebSocket(process.argv[1]); let next=0; const call=(method,params={})=>new Promise((resolve,reject)=>{const id=++next; const timer=setTimeout(()=>reject(new Error(\"timeout \"+method)),10000); const on=(event)=>{const msg=JSON.parse(event.data); if(msg.id!==id)return; ws.removeEventListener(\"message\",on); clearTimeout(timer); msg.error?reject(new Error(JSON.stringify(msg.error))):resolve(msg.result)}; ws.addEventListener(\"message\",on); ws.send(JSON.stringify({id,method,params}));}); ws.addEventListener(\"open\",async()=>{try{const result=await call(\"Runtime.evaluate\",{expression:\"(()=>{const v=document.querySelector(\\\"video\\\"); if(!v) return {error:\\\"no video\\\", title:document.title}; v.currentTime=92; v.pause(); return {title:document.title, time:v.currentTime, duration:v.duration, readyState:v.readyState};})()\",returnByValue:true}); console.log(JSON.stringify(result.result.value)); setTimeout(async()=>{const shot=await call(\"Page.captureScreenshot\",{format:\"png\",captureBeyondViewport:false}); fs.writeFileSync(\"/tmp/kamryn-92.png\",Buffer.from(shot.data,\"base64\")); console.log(\"wrote /tmp/kamryn-92.png\"); ws.close();} ,3000);}catch(error){console.error(error);ws.close();process.exitCode=1;}});", "ws://127.0.0.1:9224/devtools/page/5D960A5FFCC4A8E769004D29C24E93F2"], decision="allow")
prefix_rule(pattern=["node", "-e", "const fs=require(\"fs\"); const ws=new WebSocket(process.argv[1]); let next=0; const call=(method,params={})=>new Promise((resolve,reject)=>{const id=++next; const timer=setTimeout(()=>reject(new Error(\"timeout \"+method)),10000); const on=(event)=>{const msg=JSON.parse(event.data); if(msg.id!==id)return; ws.removeEventListener(\"message\",on); clearTimeout(timer); msg.error?reject(new Error(JSON.stringify(msg.error))):resolve(msg.result)}; ws.addEventListener(\"message\",on); ws.send(JSON.stringify({id,method,params}));}); ws.addEventListener(\"open\",async()=>{try{const result=await call(\"Runtime.evaluate\",{expression:\"(()=>{const b=[...document.querySelectorAll(\\\"button\\\")].find(x=>x.innerText.trim()===\\\"Reject all\\\"); if(b)b.click(); const v=document.querySelector(\\\"video\\\"); if(v){v.currentTime=92;v.pause();} return {clicked:!!b,time:v?.currentTime,ready:v?.readyState};})()\",returnByValue:true}); console.log(JSON.stringify(result.result.value)); setTimeout(async()=>{const shot=await call(\"Page.captureScreenshot\",{format:\"png\"}); fs.writeFileSync(\"/tmp/kamryn-92-dismissed.png\",Buffer.from(shot.data,\"base64\")); console.log(\"wrote /tmp/kamryn-92-dismissed.png\"); ws.close();},3000);}catch(error){console.error(error);ws.close();process.exitCode=1;}});", "ws://127.0.0.1:9224/devtools/page/5D960A5FFCC4A8E769004D29C24E93F2"], decision="allow")
prefix_rule(pattern=["node", "-e", "const ws=new WebSocket(process.argv[1]); const id=1; ws.addEventListener(\"open\",()=>ws.send(JSON.stringify({id,method:\"Runtime.evaluate\",params:{expression:\"(()=>{const p=window.ytInitialPlayerResponse; return {has:!!p, keys:p?Object.keys(p):[], storyboard:p?.storyboards?.playerStoryboardSpecRenderer?.spec || null};})()\",returnByValue:true}}))); ws.addEventListener(\"message\",e=>{const m=JSON.parse(e.data); if(m.id===id){console.log(JSON.stringify(m.result.result.value));ws.close();}});", "ws://127.0.0.1:9224/devtools/page/5D960A5FFCC4A8E769004D29C24E93F2"], decision="allow")
prefix_rule(pattern=["curl", "-fsSL", "https://i.ytimg.com/sb/GMuo4VQXxeE/storyboard3_L2/M18.jpg?sqp=-oaymwENSDfyq4qpAwVwAcABBqLzl_8DBgjYiLyhBg==", "-o", "/tmp/kamryn-storyboard-90.jpg"], decision="allow")
prefix_rule(pattern=["curl", "-fsSL", "https://i.ytimg.com/sb/GMuo4VQXxeE/storyboard3_L2/M18.jpg?sqp=-oaymwENSDfyq4qpAwVwAcABBqLzl_8DBgjYiLyhBg==&sigh=AOn4CLA1Q8DXdXK2D8P45coi55KPTIAyRg", "-o", "/tmp/kamryn-storyboard-90.jpg"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "rm -f /home/chrly/source/nvim-modus-themes/nvim.log /home/chrly/source/nvim-modus-themes/scripts/__pycache__/generate.cpython-314.pyc && rmdir /home/chrly/source/nvim-modus-themes/scripts/__pycache__ && python3 scripts/generate.py && NVIM_LOG_FILE=/tmp/nvim-modus-themes-nvim.log nvim --clean --headless '+set runtimepath^=.' '+colorscheme modus_operandi' '+colorscheme modus_vivendi' '+lua assert(vim.g.colors_name == \"modus_vivendi\")' +qa && git diff --check && git status --short"], decision="allow")
prefix_rule(pattern=["swaymsg", "-t", "get_tree", "-r"], decision="allow")
prefix_rule(pattern=["npm", "run", "tauri:x11"], decision="allow")
prefix_rule(pattern=["curl", "-fsSL"], decision="allow")
prefix_rule(pattern=["node", "/tmp/chessable-filter-probe.mjs"], decision="allow")
prefix_rule(pattern=["python3", "/tmp/chessable-cleanup.py"], decision="allow")
prefix_rule(pattern=["ps", "-C", "cargo,rustc,chessable-exporter", "-o", "pid,etime,comm"], decision="allow")
prefix_rule(pattern=["cargo", "clippy", "--all-targets", "--all-features", "--", "-D", "warnings"], decision="allow")
prefix_rule(pattern=["/home/chrly/source/chessable-export/target/release/chessable-exporter", "browser-capture", "/tmp/chessable-capture-check.json", "/tmp/chessable-capture-check-source.json"], decision="allow")
prefix_rule(pattern=["./sync-chessable", "--all", "--dry-run"], decision="allow")
prefix_rule(pattern=["git", "add", "src/browser.rs", "tests/library-scan.test.mjs"], decision="allow")
prefix_rule(pattern=["swaymsg", "reload"], decision="allow")
