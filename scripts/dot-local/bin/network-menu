#!/usr/bin/env bash
# A small Rofi front end for NetworkManager, suitable for a tray-less Sway
# session. It uses nmcli directly, so saved NetworkManager connections work
# without keeping an applet running.
set -euo pipefail

menu() {
    rofi -dmenu -i -p "Network" -theme-str 'window { width: 32em; }'
}

wifi_state() {
    nmcli -g WIFI general 2>/dev/null || printf 'disabled\n'
}

choose_network() {
    local ssid password
    ssid=$(nmcli -g SSID device wifi list --rescan auto 2>/dev/null \
        | sed '/^$/d' | awk '!seen[$0]++' | menu) || return 0
    [ -n "$ssid" ] || return 0

    # First try a saved connection. If NetworkManager needs a secret, ask
    # privately and retry with the supplied password.
    if ! nmcli device wifi connect "$ssid"; then
        password=$(rofi -dmenu -password -p "Password for $ssid") || return 0
        [ -n "$password" ] || return 0
        nmcli device wifi connect "$ssid" password "$password"
    fi
}

case "$(printf '%s\n' \
    "Connect to Wi-Fi…" \
    "Disconnect Wi-Fi" \
    "Turn Wi-Fi $( [ "$(wifi_state)" = enabled ] && printf off || printf on )" \
    | menu)" in
    "Connect to Wi-Fi…")
        if [ "$(wifi_state)" != enabled ]; then
            nmcli radio wifi on
        fi
        choose_network
        ;;
    "Disconnect Wi-Fi") nmcli device disconnect "$(nmcli -t -f DEVICE,TYPE,STATE device | awk -F: '$2 == "wifi" && $3 == "connected" { print $1; exit }')" ;;
    "Turn Wi-Fi off") nmcli radio wifi off ;;
    "Turn Wi-Fi on") nmcli radio wifi on ;;
esac
